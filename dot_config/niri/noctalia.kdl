layout {

    focus-ring {
        active-color   "#82502e"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#82502e"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#82502e"
        inactive-color "#9f6844"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#82502e80"
    }
}

recent-windows {
    highlight {
        active-color "#82502e"
        urgent-color "#ba1a1a"
    }
}
