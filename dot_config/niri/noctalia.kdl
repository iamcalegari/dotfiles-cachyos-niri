layout {

    focus-ring {
        active-color   "#1e2c53"
        inactive-color "#fbf8fc"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#1e2c53"
        inactive-color "#fbf8fc"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#1e2c53"
        inactive-color "#35426b"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#1e2c5380"
    }
}

recent-windows {
    highlight {
        active-color "#1e2c53"
        urgent-color "#ba1a1a"
    }
}
