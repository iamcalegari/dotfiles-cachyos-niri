layout {

    focus-ring {
        active-color   "#365b8c"
        inactive-color "#f9f9fd"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#365b8c"
        inactive-color "#f9f9fd"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#365b8c"
        inactive-color "#5074a6"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#365b8c80"
    }
}

recent-windows {
    highlight {
        active-color "#365b8c"
        urgent-color "#ba1a1a"
    }
}
