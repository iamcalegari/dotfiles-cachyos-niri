layout {

    focus-ring {
        active-color   "#745545"
        inactive-color "#fff8f6"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#745545"
        inactive-color "#fff8f6"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#745545"
        inactive-color "#8f6d5c"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#74554580"
    }
}

recent-windows {
    highlight {
        active-color "#745545"
        urgent-color "#ba1a1a"
    }
}
