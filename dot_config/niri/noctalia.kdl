layout {

    focus-ring {
        active-color   "#b7c4ff"
        inactive-color "#121318"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b7c4ff"
        inactive-color "#121318"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b7c4ff"
        inactive-color "#192f7b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b7c4ff80"
    }
}

recent-windows {
    highlight {
        active-color "#b7c4ff"
        urgent-color "#ffb4ab"
    }
}
