layout {

    focus-ring {
        active-color   "#b4c9db"
        inactive-color "#121314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b4c9db"
        inactive-color "#121314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b4c9db"
        inactive-color "#213543"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b4c9db80"
    }
}

recent-windows {
    highlight {
        active-color "#b4c9db"
        urgent-color "#ffb4ab"
    }
}
