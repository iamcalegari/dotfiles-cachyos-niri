layout {

    focus-ring {
        active-color   "#bdc7d5"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bdc7d5"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bdc7d5"
        inactive-color "#8a94a1"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bdc7d580"
    }
}

recent-windows {
    highlight {
        active-color "#bdc7d5"
        urgent-color "#ffb4ab"
    }
}
