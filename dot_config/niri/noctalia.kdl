layout {

    focus-ring {
        active-color   "#5f588a"
        inactive-color "#fdf8fd"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#5f588a"
        inactive-color "#fdf8fd"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#5f588a"
        inactive-color "#948cc2"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#5f588a80"
    }
}

recent-windows {
    highlight {
        active-color "#5f588a"
        urgent-color "#ba1a1a"
    }
}
