layout {

    focus-ring {
        active-color   "#c9c0f9"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c9c0f9"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c9c0f9"
        inactive-color "#948cc2"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c9c0f980"
    }
}

recent-windows {
    highlight {
        active-color "#c9c0f9"
        urgent-color "#ffb4ab"
    }
}
