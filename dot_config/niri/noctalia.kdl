layout {

    focus-ring {
        active-color   "#584a35"
        inactive-color "#fef8f4"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#584a35"
        inactive-color "#fef8f4"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#584a35"
        inactive-color "#71624b"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#584a3580"
    }
}

recent-windows {
    highlight {
        active-color "#584a35"
        urgent-color "#ba1a1a"
    }
}
