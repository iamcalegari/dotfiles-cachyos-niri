layout {

    focus-ring {
        active-color   "#2c5c94"
        inactive-color "#f9f9fe"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#2c5c94"
        inactive-color "#f9f9fe"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#2c5c94"
        inactive-color "#4875ae"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#2c5c9480"
    }
}

recent-windows {
    highlight {
        active-color "#2c5c94"
        urgent-color "#ba1a1a"
    }
}
