layout {

    focus-ring {
        active-color   "#336177"
        inactive-color "#f9f9fb"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#336177"
        inactive-color "#f9f9fb"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#336177"
        inactive-color "#4d7a91"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#33617780"
    }
}

recent-windows {
    highlight {
        active-color "#336177"
        urgent-color "#ba1a1a"
    }
}
