layout {

    focus-ring {
        active-color   "#316762"
        inactive-color "#f8faf8"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#316762"
        inactive-color "#f8faf8"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#316762"
        inactive-color "#679d97"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#31676280"
    }
}

recent-windows {
    highlight {
        active-color "#316762"
        urgent-color "#ba1a1a"
    }
}
