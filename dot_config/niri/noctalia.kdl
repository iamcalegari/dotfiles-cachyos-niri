layout {

    focus-ring {
        active-color   "#d2c3c7"
        inactive-color "#141313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d2c3c7"
        inactive-color "#141313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d2c3c7"
        inactive-color "#695d61"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d2c3c780"
    }
}

recent-windows {
    highlight {
        active-color "#d2c3c7"
        urgent-color "#ffb4ab"
    }
}
