layout {

    focus-ring {
        active-color   "#056a69"
        inactive-color "#f7faf9"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#056a69"
        inactive-color "#f7faf9"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#056a69"
        inactive-color "#97e6e4"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#056a6980"
    }
}

recent-windows {
    highlight {
        active-color "#056a69"
        urgent-color "#ba1a1a"
    }
}
