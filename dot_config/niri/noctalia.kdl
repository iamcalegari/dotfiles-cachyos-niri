layout {

    focus-ring {
        active-color   "#00185f"
        inactive-color "#fbf8ff"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#00185f"
        inactive-color "#fbf8ff"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#00185f"
        inactive-color "#192f7b"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#00185f80"
    }
}

recent-windows {
    highlight {
        active-color "#00185f"
        urgent-color "#ba1a1a"
    }
}
