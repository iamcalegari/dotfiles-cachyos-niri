layout {

    focus-ring {
        active-color   "#8b5000"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#8b5000"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#8b5000"
        inactive-color "#fea036"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#8b500080"
    }
}

recent-windows {
    highlight {
        active-color "#8b5000"
        urgent-color "#ba1a1a"
    }
}
