layout {

    focus-ring {
        active-color   "#5f2f00"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#5f2f00"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#5f2f00"
        inactive-color "#7d4411"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#5f2f0080"
    }
}

recent-windows {
    highlight {
        active-color "#5f2f00"
        urgent-color "#ba1a1a"
    }
}
