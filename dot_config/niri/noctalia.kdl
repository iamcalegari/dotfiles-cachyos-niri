layout {

    focus-ring {
        active-color   "#555f6b"
        inactive-color "#fbf9f9"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#555f6b"
        inactive-color "#fbf9f9"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#555f6b"
        inactive-color "#8a94a1"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#555f6b80"
    }
}

recent-windows {
    highlight {
        active-color "#555f6b"
        urgent-color "#ba1a1a"
    }
}
