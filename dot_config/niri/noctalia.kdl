layout {

    focus-ring {
        active-color   "#162452"
        inactive-color "#fbf8fd"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#162452"
        inactive-color "#fbf8fd"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#162452"
        inactive-color "#2d3a69"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#16245280"
    }
}

recent-windows {
    highlight {
        active-color "#162452"
        urgent-color "#ba1a1a"
    }
}
