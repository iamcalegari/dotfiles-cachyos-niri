layout {

    focus-ring {
        active-color   "#bcc4f5"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bcc4f5"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bcc4f5"
        inactive-color "#58608b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bcc4f580"
    }
}

recent-windows {
    highlight {
        active-color "#bcc4f5"
        urgent-color "#ffb4ab"
    }
}
