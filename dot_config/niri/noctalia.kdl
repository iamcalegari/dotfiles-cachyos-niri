layout {

    focus-ring {
        active-color   "#16191c"
        inactive-color "#fcf8f8"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#16191c"
        inactive-color "#fcf8f8"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#16191c"
        inactive-color "#2b2d31"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#16191c80"
    }
}

recent-windows {
    highlight {
        active-color "#16191c"
        urgent-color "#ba1a1a"
    }
}
