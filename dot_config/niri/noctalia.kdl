layout {

    focus-ring {
        active-color   "#ddcf5d"
        inactive-color "#15130c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ddcf5d"
        inactive-color "#15130c"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ddcf5d"
        inactive-color "#c0b345"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ddcf5d80"
    }
}

recent-windows {
    highlight {
        active-color "#ddcf5d"
        urgent-color "#ffb4ab"
    }
}
