layout {

    focus-ring {
        active-color   "#9bcaff"
        inactive-color "#111417"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9bcaff"
        inactive-color "#111417"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#9bcaff"
        inactive-color "#256398"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9bcaff80"
    }
}

recent-windows {
    highlight {
        active-color "#9bcaff"
        urgent-color "#ffb4ab"
    }
}
