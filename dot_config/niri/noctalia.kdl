layout {

    focus-ring {
        active-color   "#1a364a"
        inactive-color "#faf9fb"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#1a364a"
        inactive-color "#faf9fb"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#1a364a"
        inactive-color "#324d62"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#1a364a80"
    }
}

recent-windows {
    highlight {
        active-color "#1a364a"
        urgent-color "#ba1a1a"
    }
}
