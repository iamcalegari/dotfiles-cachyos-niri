layout {

    focus-ring {
        active-color   "#bbc3ff"
        inactive-color "#131317"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bbc3ff"
        inactive-color "#131317"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bbc3ff"
        inactive-color "#202963"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bbc3ff80"
    }
}

recent-windows {
    highlight {
        active-color "#bbc3ff"
        urgent-color "#ffb4ab"
    }
}
