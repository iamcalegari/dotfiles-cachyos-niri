layout {

    focus-ring {
        active-color   "#863100"
        inactive-color "#fff8f6"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#863100"
        inactive-color "#fff8f6"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#863100"
        inactive-color "#a9450f"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#86310080"
    }
}

recent-windows {
    highlight {
        active-color "#863100"
        urgent-color "#ba1a1a"
    }
}
