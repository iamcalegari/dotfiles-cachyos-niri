layout {

    focus-ring {
        active-color   "#113849"
        inactive-color "#faf9fa"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#113849"
        inactive-color "#faf9fa"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#113849"
        inactive-color "#2b4f61"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#11384980"
    }
}

recent-windows {
    highlight {
        active-color "#113849"
        urgent-color "#ba1a1a"
    }
}
