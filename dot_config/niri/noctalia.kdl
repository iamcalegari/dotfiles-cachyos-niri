layout {

    focus-ring {
        active-color   "#ebbda7"
        inactive-color "#161311"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ebbda7"
        inactive-color "#161311"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ebbda7"
        inactive-color "#825e4c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ebbda780"
    }
}

recent-windows {
    highlight {
        active-color "#ebbda7"
        urgent-color "#ffb4ab"
    }
}
