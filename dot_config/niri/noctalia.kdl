layout {

    focus-ring {
        active-color   "#f8bb67"
        inactive-color "#17130d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f8bb67"
        inactive-color "#17130d"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#f8bb67"
        inactive-color "#c18b3c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f8bb6780"
    }
}

recent-windows {
    highlight {
        active-color "#f8bb67"
        urgent-color "#ffb4ab"
    }
}
