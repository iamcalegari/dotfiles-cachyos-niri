layout {

    focus-ring {
        active-color   "#c1c2f8"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c1c2f8"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c1c2f8"
        inactive-color "#8b8cbf"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c1c2f880"
    }
}

recent-windows {
    highlight {
        active-color "#c1c2f8"
        urgent-color "#ffb4ab"
    }
}
