layout {

    focus-ring {
        active-color   "#7d5627"
        inactive-color "#fff8f4"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#7d5627"
        inactive-color "#fff8f4"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#7d5627"
        inactive-color "#c2935e"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#7d562780"
    }
}

recent-windows {
    highlight {
        active-color "#7d5627"
        urgent-color "#ba1a1a"
    }
}
