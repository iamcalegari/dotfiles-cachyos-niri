layout {

    focus-ring {
        active-color   "#d8c49d"
        inactive-color "#151311"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d8c49d"
        inactive-color "#151311"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d8c49d"
        inactive-color "#7b6b4a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d8c49d80"
    }
}

recent-windows {
    highlight {
        active-color "#d8c49d"
        urgent-color "#ffb4ab"
    }
}
