layout {

    focus-ring {
        active-color   "#ffb694"
        inactive-color "#1c110b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb694"
        inactive-color "#1c110b"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb694"
        inactive-color "#ef6716"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb69480"
    }
}

recent-windows {
    highlight {
        active-color "#ffb694"
        urgent-color "#ffb4ab"
    }
}
