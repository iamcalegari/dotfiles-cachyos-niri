layout {

    focus-ring {
        active-color   "#ecbe91"
        inactive-color "#161310"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ecbe91"
        inactive-color "#161310"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ecbe91"
        inactive-color "#714f2b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ecbe9180"
    }
}

recent-windows {
    highlight {
        active-color "#ecbe91"
        urgent-color "#ffb4ab"
    }
}
