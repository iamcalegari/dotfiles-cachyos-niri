layout {

    focus-ring {
        active-color   "#ffb77d"
        inactive-color "#19120d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb77d"
        inactive-color "#19120d"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb77d"
        inactive-color "#cb7f3a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb77d80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb77d"
        urgent-color "#ffb4ab"
    }
}
