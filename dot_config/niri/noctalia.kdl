layout {

    focus-ring {
        active-color   "#ddc0bf"
        inactive-color "#151313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ddc0bf"
        inactive-color "#151313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ddc0bf"
        inactive-color "#b39897"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ddc0bf80"
    }
}

recent-windows {
    highlight {
        active-color "#ddc0bf"
        urgent-color "#ffb4ab"
    }
}
