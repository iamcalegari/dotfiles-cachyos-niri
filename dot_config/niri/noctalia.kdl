layout {

    focus-ring {
        active-color   "#aecae3"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aecae3"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#aecae3"
        inactive-color "#324d62"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aecae380"
    }
}

recent-windows {
    highlight {
        active-color "#aecae3"
        urgent-color "#ffb4ab"
    }
}
