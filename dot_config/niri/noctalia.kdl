layout {

    focus-ring {
        active-color   "#a4c9ff"
        inactive-color "#111317"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a4c9ff"
        inactive-color "#111317"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a4c9ff"
        inactive-color "#4875ae"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a4c9ff80"
    }
}

recent-windows {
    highlight {
        active-color "#a4c9ff"
        urgent-color "#ffb4ab"
    }
}
