layout {

    focus-ring {
        active-color   "#c8fffd"
        inactive-color "#101414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c8fffd"
        inactive-color "#101414"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c8fffd"
        inactive-color "#97e6e4"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c8fffd80"
    }
}

recent-windows {
    highlight {
        active-color "#c8fffd"
        urgent-color "#ffb4ab"
    }
}
