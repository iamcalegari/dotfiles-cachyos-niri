layout {

    focus-ring {
        active-color   "#875129"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#875129"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#875129"
        inactive-color "#df9c6d"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#87512980"
    }
}

recent-windows {
    highlight {
        active-color "#875129"
        urgent-color "#ba1a1a"
    }
}
