layout {

    focus-ring {
        active-color   "#9dcbf5"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9dcbf5"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#9dcbf5"
        inactive-color "#034164"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9dcbf580"
    }
}

recent-windows {
    highlight {
        active-color "#9dcbf5"
        urgent-color "#ffb4ab"
    }
}
