layout {

    focus-ring {
        active-color   "#aa2f21"
        inactive-color "#fff8f6"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#aa2f21"
        inactive-color "#fff8f6"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#aa2f21"
        inactive-color "#cc4736"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#aa2f2180"
    }
}

recent-windows {
    highlight {
        active-color "#aa2f21"
        urgent-color "#ba1a1a"
    }
}
