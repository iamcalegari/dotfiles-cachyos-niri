layout {

    focus-ring {
        active-color   "#476083"
        inactive-color "#faf9fc"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#476083"
        inactive-color "#faf9fc"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#476083"
        inactive-color "#92abd2"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#47608380"
    }
}

recent-windows {
    highlight {
        active-color "#476083"
        urgent-color "#ba1a1a"
    }
}
