layout {

    focus-ring {
        active-color   "#f1b0f9"
        inactive-color "#161216"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f1b0f9"
        inactive-color "#161216"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#f1b0f9"
        inactive-color "#b77bc0"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f1b0f980"
    }
}

recent-windows {
    highlight {
        active-color "#f1b0f9"
        urgent-color "#ffb4ab"
    }
}
