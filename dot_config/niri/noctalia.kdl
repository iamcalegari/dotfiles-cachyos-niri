layout {

    focus-ring {
        active-color   "#b7c4fc"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b7c4fc"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b7c4fc"
        inactive-color "#2d3a69"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b7c4fc80"
    }
}

recent-windows {
    highlight {
        active-color "#b7c4fc"
        urgent-color "#ffb4ab"
    }
}
