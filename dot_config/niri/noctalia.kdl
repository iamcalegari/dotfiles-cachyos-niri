layout {

    focus-ring {
        active-color   "#dfbfbe"
        inactive-color "#151313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#dfbfbe"
        inactive-color "#151313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#dfbfbe"
        inactive-color "#301d1d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#dfbfbe80"
    }
}

recent-windows {
    highlight {
        active-color "#dfbfbe"
        urgent-color "#ffb4ab"
    }
}
