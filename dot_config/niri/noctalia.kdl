layout {

    focus-ring {
        active-color   "#bcc5ef"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bcc5ef"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bcc5ef"
        inactive-color "#515a7f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bcc5ef80"
    }
}

recent-windows {
    highlight {
        active-color "#bcc5ef"
        urgent-color "#ffb4ab"
    }
}
