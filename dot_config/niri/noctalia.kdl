layout {

    focus-ring {
        active-color   "#275387"
        inactive-color "#f9f9fe"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#275387"
        inactive-color "#f9f9fe"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#275387"
        inactive-color "#426ba1"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#27538780"
    }
}

recent-windows {
    highlight {
        active-color "#275387"
        urgent-color "#ba1a1a"
    }
}
