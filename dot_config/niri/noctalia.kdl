layout {

    focus-ring {
        active-color   "#1f3956"
        inactive-color "#faf9fc"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#1f3956"
        inactive-color "#faf9fc"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#1f3956"
        inactive-color "#37506e"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#1f395680"
    }
}

recent-windows {
    highlight {
        active-color "#1f3956"
        urgent-color "#ba1a1a"
    }
}
