layout {

    focus-ring {
        active-color   "#2d5ba4"
        inactive-color "#f9f9ff"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#2d5ba4"
        inactive-color "#f9f9ff"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#2d5ba4"
        inactive-color "#4974bf"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#2d5ba480"
    }
}

recent-windows {
    highlight {
        active-color "#2d5ba4"
        urgent-color "#ba1a1a"
    }
}
