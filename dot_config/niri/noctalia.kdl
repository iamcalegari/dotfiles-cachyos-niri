layout {

    focus-ring {
        active-color   "#44407f"
        inactive-color "#fcf8fe"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#44407f"
        inactive-color "#fcf8fe"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#44407f"
        inactive-color "#5c5899"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#44407f80"
    }
}

recent-windows {
    highlight {
        active-color "#44407f"
        urgent-color "#ba1a1a"
    }
}
