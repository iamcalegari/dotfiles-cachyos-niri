layout {

    focus-ring {
        active-color   "#f2bd7e"
        inactive-color "#17130e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f2bd7e"
        inactive-color "#17130e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#f2bd7e"
        inactive-color "#c19156"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f2bd7e80"
    }
}

recent-windows {
    highlight {
        active-color "#f2bd7e"
        urgent-color "#ffb4ab"
    }
}
