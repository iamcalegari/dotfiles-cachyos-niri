layout {

    focus-ring {
        active-color   "#844f25"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#844f25"
        inactive-color "#fff8f5"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#844f25"
        inactive-color "#a1673b"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#844f2580"
    }
}

recent-windows {
    highlight {
        active-color "#844f25"
        urgent-color "#ba1a1a"
    }
}
