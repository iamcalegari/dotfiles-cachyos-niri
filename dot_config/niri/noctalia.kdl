layout {

    focus-ring {
        active-color   "#78592c"
        inactive-color "#fff8f4"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#78592c"
        inactive-color "#fff8f4"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#78592c"
        inactive-color "#e4bb85"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#78592c80"
    }
}

recent-windows {
    highlight {
        active-color "#78592c"
        urgent-color "#ba1a1a"
    }
}
