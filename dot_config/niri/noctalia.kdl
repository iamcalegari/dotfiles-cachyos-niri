layout {

    focus-ring {
        active-color   "#002a44"
        inactive-color "#f9f9fc"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#002a44"
        inactive-color "#f9f9fc"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#002a44"
        inactive-color "#034164"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#002a4480"
    }
}

recent-windows {
    highlight {
        active-color "#002a44"
        urgent-color "#ba1a1a"
    }
}
