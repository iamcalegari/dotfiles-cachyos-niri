layout {

    focus-ring {
        active-color   "#94ccff"
        inactive-color "#101418"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#94ccff"
        inactive-color "#101418"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#94ccff"
        inactive-color "#2898df"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#94ccff80"
    }
}

recent-windows {
    highlight {
        active-color "#94ccff"
        urgent-color "#ffb4ab"
    }
}
