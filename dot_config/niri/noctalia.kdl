layout {

    focus-ring {
        active-color   "#ffd7a4"
        inactive-color "#16130f"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffd7a4"
        inactive-color "#16130f"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffd7a4"
        inactive-color "#e4bb85"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffd7a480"
    }
}

recent-windows {
    highlight {
        active-color "#ffd7a4"
        urgent-color "#ffb4ab"
    }
}
