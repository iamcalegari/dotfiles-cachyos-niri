// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// You will have to remove "/-" and edit it before it takes effect.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

/- output "DP-1" {
    mode "2560x1440@120" // Set resolution and refresh rate
    scale 1 // No scaling (use 2 for HiDPI)
}


output "HDMI-A-1" {
	mode "1920x1080@60.000"
	scale 1
	position x=1920 y=0
	transform "normal"
	focus-at-startup
}

output "eDP-1" {
	mode "1920x1080@120.003"
	scale 1
	position x=0 y=0
	transform "normal"
	focus-at-startup
	variable-refresh-rate
}

/- output "HDMI-A-1" {
	mode "1920x1080@60.000"
	scale 1
	position x=0 y=0
	transform "normal"
	focus-at-startup
}


output "HDMI-A-1" {
	mode "2560x1080@74.991"
	scale 1
	position x=0 y=1080
	transform "normal"
	focus-at-startup
	variable-refresh-rate
}

output "Samsung Electric Company SAMSUNG 0x01000E00" {

}

debug {
    keep-laptop-panel-on-when-lid-is-closed false
}

