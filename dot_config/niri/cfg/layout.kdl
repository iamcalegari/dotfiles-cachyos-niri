layout {
    gaps 14 // Gap between windows
        
    center-focused-column "never" // Don’t auto-center focused column
    always-center-single-column

    background-color "transparent" // <- needed for noctalia-shell to set wallpaper

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

	focus-ring {
		width 1.5
	}

    struts {}
}

// Parâmetros globais do blur (usado pela layer-rule do Noctalia em rules.kdl).
blur {
    passes 3
    offset 4.0
    noise 0.02
    saturation 1.4
}
