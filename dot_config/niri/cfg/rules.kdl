    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    // Floating Noctalia settings window (v5).
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // Efeito "vidro" (blur) nas superfícies do Noctalia — Niri 26.04+.
    // O Noctalia pede o blur via ext_background_effect_v1; aqui só ajustamos.
    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
            blur true
            xray false
        }
    }

    layer-rule {
        match namespace="noctalia-window-switcher"
        background-effect {
            blur true
            xray false
        }
    }
